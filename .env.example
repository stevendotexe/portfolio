NEXT_PUBLIC_SITE_URL=https://stevensimbolon.dev

# Supabase — values are safe in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Service-role key — used ONLY by local scripts (e.g. photos:upload).
# NEVER commit this. NEVER expose to the browser (no NEXT_PUBLIC_ prefix).
# Get it from: Supabase Dashboard → Project Settings → API → Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
